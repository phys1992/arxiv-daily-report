[Unit]
# 用户级单元：放到 ~/.config/systemd/user/，用 `systemctl --user` 管理。
# 不需要 root，且天然以你自己的身份运行，能读到本项目的 config.json / secrets.json。
Description=arXiv 论文日报（arxiv-daily-report）常驻调度
Documentation=https://github.com/phys1992/arxiv-daily-report
After=network-online.target

[Service]
Type=simple
# 由 install.sh 在安装时替换为真实路径
WorkingDirectory=@PROJECT_DIR@
ExecStart=@VENV_PY@ @PROJECT_DIR@/run.py daemon

# systemd 只负责把进程拉起来；定时逻辑在进程内部的调度器里，
# 因此用 Web 界面改运行时间可以立即生效，无需 reload 服务。
Restart=always
RestartSec=10

KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arxiv-daily-report

# 可选：在此文件里放 DEEPSEEK_API_KEY=... 之类的密钥（文件不存在也不报错）
EnvironmentFile=-@PROJECT_DIR@/.env

[Install]
WantedBy=default.target
